<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="20dp"
    android:background="@drawable/bg_combat_card"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Standard Header with Back and Close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnTopBackTask"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_button_slate"
                android:text="⟵"
                android:textColor="#FF80D8FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="⚔️ Task Assignment"
                android:textColor="#FF00E5FF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTopCloseTask"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_button_slate"
                android:text="✕"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#3300E5FF"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvTaskDialogName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Assign Task"
            android:textColor="#FFFFD700"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgTasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <RadioButton
                android:id="@+id/rbFarming"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Spirit Farming (Herbs &amp; Crops)"
                android:textColor="#FF4CAF50" />

            <RadioButton
                android:id="@+id/rbAlchemy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Alchemy Refinement (Pills)"
                android:textColor="#FF448AFF" />

            <RadioButton
                android:id="@+id/rbCrafting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Forge &amp; Crafting (Equipment)"
                android:textColor="#FFFFA726" />

            <RadioButton
                android:id="@+id/rbCultivation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Meditative Cultivation (Exp)"
                android:textColor="#FFB388FF" />

            <RadioButton
                android:id="@+id/rbMining"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Spirit Vein Mining (Stones)"
                android:textColor="#FFFFD54F" />

            <RadioButton
                android:id="@+id/rbTraining"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Martial Arts Training"
                android:textColor="#FFFF5252" />

            <RadioButton
                android:id="@+id/rbGuard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sect Mountain Patrol"
                android:textColor="#FF90A4AE" />

            <RadioButton
                android:id="@+id/rbResearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scripture Comprehension"
                android:textColor="#FF80D8FF" />

            <RadioButton
                android:id="@+id/rbTrading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Marketplace Trading"
                android:textColor="#FFFFD700" />

            <RadioButton
                android:id="@+id/rbExploring"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Secret Realm Exploration"
                android:textColor="#FF69F0AE" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelTask"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_slate"
                android:text="Cancel"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnConfirmTask"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_emerald"
                android:text="Confirm"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
