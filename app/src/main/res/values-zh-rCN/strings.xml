    <!-- Cultivator Wisdom Tips -->
    <string name="tip_1">宗门提示：指派弟子前往炼丹阁可炼制各类突破境界的灵丹妙药。</string>
    <string name="tip_2">宗门提示：道心稳固度越高，冲击大境界时走火入魔的概率越低。</string>
    <string name="tip_3">宗门提示：修炼同属性功法的弟子，其吐纳灵气效率提升50%。</string>
    <string name="tip_4">宗门提示：扩建弟子居所能大幅加快弟子体力恢复与心境安宁。</string>
    <string name="tip_5">宗门提示：灵膳堂的佳肴能迅速饱腹并提升弟子修炼积极性。</string>
    <string name="tip_6">宗门提示：渡劫前务必准备好防御法宝与护脉丹药，以抗衡九重天雷。</string>
    <string name="tip_7">宗门提示：核心真传弟子可传道授业，协助外门弟子顺利筑基。</string>
    <string name="tip_8">宗门提示：在坊市出售多余玄铁矿石，可换购稀缺天地奇珍。</string>

