<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#8000E676" />
            <stroke android:width="2dp" android:color="#FFB9F6CA" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#3300E676" />
            <stroke android:width="1.5dp" android:color="#FF00E676" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
